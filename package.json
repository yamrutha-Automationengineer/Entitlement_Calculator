{
  "name": "holiday-entitlement-ui-tests",
  "version": "2.1.0",
  "description": "Gherkin (playwright-bdd) UI tests for the GOV.UK 'Calculate your holiday entitlement' tool, driven by the decision table",
  "private": true,
  "scripts": {
    "bdd:gen": "node scripts/generate-features.mjs && bddgen",
    "test": "npm run bdd:gen && playwright test",
    "test:headed": "npm run bdd:gen && playwright test --headed",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
